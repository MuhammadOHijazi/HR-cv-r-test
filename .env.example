# =============================================================================
# CV Screening Pipeline — environment configuration
# Copy to `.env` and fill in. Every variable below has a working default, so the
# backend boots and the whole test-suite runs with MOCK_MODE=true and no
# credentials at all.
# =============================================================================

# -----------------------------------------------------------------------------
# Gemini (the only LLM provider)
# -----------------------------------------------------------------------------
# Comma-separated pool of API keys. The client round-robins across them, marks a
# key as cooling down on 429/quota/5xx, and retries the same request on the next
# healthy key. More keys = more headroom before a job pauses.
GEMINI_API_KEYS=

# Model tiers. Extraction and vision run on the flash tier (cheap, high volume);
# judging runs on the pro tier (temperature 0, rubric-scored).
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_DIM=768

# Retry / backoff behaviour of the key pool.
GEMINI_MAX_ATTEMPTS_PER_REQUEST=6
GEMINI_COOLDOWN_BASE_SECONDS=30
GEMINI_COOLDOWN_MAX_SECONDS=900

# -----------------------------------------------------------------------------
# Google Drive (service account)
# -----------------------------------------------------------------------------
# Absolute path to the service-account JSON key file. Share your CV folders with
# the `client_email` inside that file (the Settings page shows it).
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_PAGE_SIZE=200

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
# Raw CV files land in $STORAGE_DIR/raw, extracted text in $STORAGE_DIR/text.
STORAGE_DIR=./data

# -----------------------------------------------------------------------------
# Routing thresholds (per-job defaults; each job can override them in the UI)
# -----------------------------------------------------------------------------
# score >= SHORTLIST_SCORE_MIN and confidence >= CONFIDENCE_MIN and no flags
#   -> auto_shortlist
SHORTLIST_SCORE_MIN=75
# score < REJECT_SCORE_MAX with confident evidence -> preliminary_reject
# (still requires a one-click human batch confirmation; never final by machine)
REJECT_SCORE_MAX=45
# Below this confidence, everything routes to human review whatever the score.
CONFIDENCE_MIN=0.7
# Gap (0-100) between two scorers measuring the SAME quantity above which
# confidence is capped. The judge's rubric has 30-point steps, so keep this
# above 30 or a one-level difference of opinion counts as disagreement.
DISAGREEMENT_CAP=35
DISAGREEMENT_CONFIDENCE_CEILING=0.65
# Stated vs computed years-of-experience gap (years) that raises a review flag.
YEARS_CONFLICT_TOLERANCE=1.5
# Fuzzy-match ratio an evidence quote must reach against the source text.
EVIDENCE_MATCH_THRESHOLD=0.8
# Source-text quality below which a CV is flagged as low-OCR-quality.
MIN_SOURCE_QUALITY=0.55

# -----------------------------------------------------------------------------
# Extraction
# -----------------------------------------------------------------------------
# Re-prompts allowed when the model's JSON fails validation.
EXTRACTION_MAX_RETRIES=2
# Field confidence at or above this counts as "high confidence" in the rules gate.
HIGH_CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Behaviour
# -----------------------------------------------------------------------------
# true  -> deterministic in-process fakes for Gemini and Drive (no credentials)
# false -> real Gemini SDK and real Drive service account
MOCK_MODE=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Mock mode fixtures
# -----------------------------------------------------------------------------
# In MOCK_MODE the fake Drive is seeded from this local directory, so the whole
# app is clickable end to end with no credentials. Generate the files with
# `python scripts/generate_test_data.py`.
MOCK_DRIVE_DIR=./data/synthetic/cvs
MOCK_DRIVE_FOLDER_NAME=Synthetic CVs (mock)
